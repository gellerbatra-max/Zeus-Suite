# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env
.env
.env.*
!.env.example
# Vite convention: .env.<mode> files (no secrets, just per-environment defaults) are committed;
# only *.local variants (covered by the frontend's own .gitignore) hold anything sensitive.
!apps/*/.env.development
!apps/*/.env.production

# Node (future frontends)
node_modules/
dist/
build/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Azurite local emulator state
infra/azurite-data/
__azurite*__.json
__blobstorage__/
